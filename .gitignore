# Git Ignore Rules — Oracle ERP & Database Center of Excellence

# Credentials, Secrets & Keys (Strictly Prohibited from VCS)
*.key
*.pem
*.pfx
*.p12
*.wallet
*.cwallet.sso
*.ewallet.p12
.env
.env.*
secrets/
credentials/
*password*
*passwd*

# Database Dumps, Traces & Diagnostic Logs
*.dmp
*.log
*.trc
*.trm
*.out
*.aud
*.xml.gz
*.dmp.gz
cfgtoollogs/
oradiag_*/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.bak

# Temporary Artifacts
tmp/
scratch/
